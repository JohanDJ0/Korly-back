# Copia este archivo como .env (no se sube al repo). Los mismos valores públicos que usa la web (frontend/.env):
# la llave anónima de Supabase y la del sitio de Turnstile son públicas por diseño; las secretas nunca van en la app.

# Mismo proyecto de Supabase que la web y el backend (solo para Auth: login y sesión).
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL base del backend, incluyendo /v1. La app habla con la API ya desplegada.
EXPO_PUBLIC_API_BASE_URL=https://api.korly.com.mx/v1

# Llave PÚBLICA del sitio de Cloudflare Turnstile (la misma de la web). Vacía = captcha apagado
# (solo sirve si el captcha también está apagado en Supabase). Ver src/components/CaptchaTurnstile.tsx.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
