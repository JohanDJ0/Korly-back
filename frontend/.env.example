# Mismo proyecto de Supabase que usa el backend (ver backend/.env.example).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# URL base del backend, incluyendo /v1 (ver backend/README.md).
VITE_API_BASE_URL=http://localhost:3000/v1

# --- Observabilidad (opcional) ---
# Sin esto, Sentry.init nunca se llama — ver src/lib/observabilidad.ts.
# Dejar vacío en desarrollo.
VITE_SENTRY_DSN=
