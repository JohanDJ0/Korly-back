# Mismo proyecto de Supabase que usa el backend (ver backend/.env.example).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# URL base del backend, incluyendo /v1 (ver backend/README.md).
VITE_API_BASE_URL=http://localhost:3000/v1

# --- Observabilidad (opcional) ---
# Sin esto, Sentry.init nunca se llama — ver src/lib/observabilidad.ts.
# Dejar vacío en desarrollo.
VITE_SENTRY_DSN=

# --- Captcha de Cloudflare Turnstile (opcional) ---
# Llave PÚBLICA del sitio (la secreta va solo en Supabase → Authentication → Attack Protection). Vacía = captcha apagado.
# Con el captcha encendido en Supabase, también hace falta aquí para iniciar sesión en local: el widget de Cloudflare debe
# incluir "localhost" entre sus dominios. Ver src/lib/turnstile.ts.
VITE_TURNSTILE_SITE_KEY=

# --- Responsable de los avisos legales (aviso de privacidad y términos) ---
# NO se escriben en el código: el repositorio es público. Sin estas variables las páginas
# legales muestran PENDIENTE y el banner de borrador. En producción van en Vercel
# (Environment Variables, tipo Config), y hay que volver a desplegar para que se apliquen.
# Ver src/lib/datos-responsable.ts.
VITE_RESPONSABLE_NOMBRE=
VITE_RESPONSABLE_DOMICILIO=
VITE_RESPONSABLE_JURISDICCION=
