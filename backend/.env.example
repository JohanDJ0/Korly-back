# Copiar a .env y llenar con los valores del proyecto Supabase (Project Settings > API y > Database).
# .env nunca se versiona.

PORT=3000

# Orígenes permitidos por CORS, separados por coma. El del frontend en
# desarrollo (Vite) ya es el default si se omite esta variable.
CORS_ORIGIN=http://localhost:5173

# --- Supabase Auth ---
# Se usan para validar el JWT del usuario en cada request (ver src/shared/supabase-admin.ts).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Conexión de administración (migraciones) ---
# Rol "postgres" de Supabase. Solo lo usa drizzle-kit para generar/aplicar migraciones.
# El servidor en ejecución NUNCA debe usar esta URL (ese rol tiene BYPASSRLS).
DATABASE_URL=postgresql://postgres:PASSWORD@db.TU-PROYECTO.supabase.co:5432/postgres

# --- Conexión de la aplicación (runtime) ---
# Rol "app_backend", creado a mano una sola vez con scripts/bootstrap-roles.sql.
# Es la que usa el servidor Fastify para servir requests: por eso las políticas RLS aplican.
APP_DATABASE_URL=postgresql://app_backend:PASSWORD@db.TU-PROYECTO.supabase.co:5432/postgres
