# Copiar a .env y llenar con los valores del proyecto Supabase (Project Settings > API y > Database).
# .env nunca se versiona.

PORT=3000

# Orígenes permitidos por CORS, separados por coma. El del frontend en
# desarrollo (Vite) ya es el default si se omite esta variable.
CORS_ORIGIN=http://localhost:5173

# --- Supabase Auth ---
# Se usan para validar el JWT del usuario en cada request (ver src/shared/supabase-admin.ts).
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Conexión de administración (migraciones + el job de recordatorios) ---
# Rol "postgres" de Supabase (BYPASSRLS) — lo usa drizzle-kit y
# shared/db-admin.ts (scripts/enviar-recordatorios.ts, el único que
# necesita enumerar tenants; ver backend/README.md, "Recordatorios por
# correo"). El SERVIDOR FASTIFY en ejecución nunca debe usar esta URL.
#
# Connection pooler en modo SESSION (puerto 5432, no 6543 — modo
# transaction no da la semántica de sesión completa que necesitan las
# migraciones), no la conexión directa "db.TU-PROYECTO.supabase.co":
# mismo hallazgo real que APP_DATABASE_URL de abajo, verificado dos
# veces contra la conexión directa el mismo día. Usuario
# "postgres.TU-PROYECTO" (formato Supavisor: rol.referencia-de-proyecto).
DATABASE_URL=postgresql://postgres.TU-PROYECTO:PASSWORD@aws-0-TU-REGION.pooler.supabase.com:5432/postgres

# --- Conexión de la aplicación (runtime) ---
# Rol "app_backend", creado a mano una sola vez con scripts/bootstrap-roles.sql.
# Es la que usa el servidor Fastify para servir requests: por eso las políticas RLS aplican.
#
# Usar el connection pooler de Supabase (Project Settings > Database >
# Connection Pooling > "Connect" > Transaction pooler), no la conexión
# directa "db.TU-PROYECTO.supabase.co" — hallazgo real: esa conexión
# directa tuvo fallas intermitentes de DNS en desarrollo
# (getaddrinfo ENOENT), mientras que el dominio principal de Supabase
# seguía resolviendo bien. El pooler es infraestructura separada, sin
# ese problema. El usuario va como "app_backend.TU-PROYECTO" (formato
# de Supavisor: rol.referencia-de-proyecto), no solo "app_backend".
# `shared/db.ts` ya pasa `prepare: false` al cliente de postgres.js,
# requisito del modo transacción del pooler (pgbouncer).
APP_DATABASE_URL=postgresql://app_backend.TU-PROYECTO:PASSWORD@aws-0-TU-REGION.pooler.supabase.com:6543/postgres

# --- Observabilidad (opcional) ---
# Sin esto, Sentry.init nunca se llama y no pasa nada — ver
# src/shared/observabilidad.ts. Dejar vacío en desarrollo/CI.
SENTRY_DSN=

# --- Recordatorios por correo (opcional) ---
# Sin RESEND_API_KEY, scripts/enviar-recordatorios.ts no manda nada
# (no-op seguro, ver src/shared/email.ts) — dejar vacío en
# desarrollo/CI. RESEND_REMITENTE requiere un dominio verificado en
# Resend; mientras tanto se puede probar con el dominio de prueba de
# Resend (solo entrega a la cuenta dueña de la API key).
RESEND_API_KEY=
RESEND_REMITENTE=Korly <hola@TU-DOMINIO>

# --- Suscripciones (opcional, ver backend/README.md "Suscripciones (Stripe)") ---
# Sin STRIPE_SECRET_KEY, modulos/suscripciones/ no llama a Stripe (no-op
# seguro, ver src/shared/stripe.ts) — dejar vacío en desarrollo/CI.
# STRIPE_PRICE_MENSUAL/ANUAL son ids de Price (price_...), creados una
# sola vez contra la cuenta de Stripe, nunca en código.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MENSUAL=
STRIPE_PRICE_ANUAL=
# Se obtiene corriendo `stripe listen --forward-to localhost:3000/v1/webhooks/stripe`
# en local (imprime un whsec_...); en producción, del endpoint configurado en el dashboard de Stripe.
STRIPE_WEBHOOK_SECRET=
# Destino de redirección tras el Checkout/Portal de Stripe — no confundir con CORS_ORIGIN (arriba).
FRONTEND_URL=http://localhost:5173

